# Copy to .env.local (git-ignored) and fill in. Names only here; never commit values.
# Both are read in src/lib/supabase.ts and the app throws at startup if either is missing.

# Supabase project URL (Project Settings -> API)
VITE_SUPABASE_URL=
# Supabase anon / publishable key. It ships in the browser bundle by design; access is governed by RLS.
VITE_SUPABASE_ANON_KEY=
